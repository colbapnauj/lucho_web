# Firebase (configuración cliente - usado en admin y en el sitio)
# 1. Copia este archivo: cp .env.example .env
# 2. Rellena los valores desde Firebase Console > Configuración del proyecto
# 3. Ejecuta: npm run generate:firebase
# En Netlify/CI configura las mismas variables en el dashboard.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
